---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { services } from '../../data/services';
import { BUSINESS, SITE_URL } from '../../config';

// One page per service that HAS `detail` content. Services without detail
// generate nothing, so no thin/placeholder pages are ever published.
export const getStaticPaths = (() =>
  services
    .filter((s) => s.detail)
    .map((s) => ({ params: { slug: s.slug }, props: { service: s } }))) satisfies GetStaticPaths;

const { service } = Astro.props;
const detail = service.detail!;

const pageTitle =
  detail.metaTitle ?? `${service.title} in Helena, MT | ${BUSINESS.name}`;
const pageDescription = detail.metaDescription ?? service.description;
const pageUrl = `${SITE_URL}/services/${service.slug}/`;

// MedicalWebPage for the service, tied back to the clinic entity, plus a
// breadcrumb trail (Home › Services › <service>).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      about: { '@type': 'MedicalProcedure', name: service.title },
      isPartOf: { '@id': `${SITE_URL}/#clinic` },
      provider: { '@id': `${SITE_URL}/#clinic` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/#services` },
        { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <article class="max-w-3xl mx-auto px-6 lg:px-8 py-12 lg:py-16">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-warm-gray">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-accent-blue transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#services" class="hover:text-accent-blue transition-colors">Services</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-700 font-medium" aria-current="page">{service.title}</li>
        </ol>
      </nav>

      <h1 class="text-3xl lg:text-4xl font-bold text-brand-700 leading-tight mb-6">
        {service.title}
      </h1>

      {detail.intro.map((paragraph) => (
        <p class="text-lg text-gray-700 leading-relaxed mb-4">{paragraph}</p>
      ))}

      {detail.sections?.map((section) => (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-brand-700 mb-4">{section.heading}</h2>
          {section.body.map((paragraph) => (
            <p class="text-gray-700 leading-relaxed mb-4">{paragraph}</p>
          ))}
        </section>
      ))}

      <!-- CTA -->
      <div class="mt-12 rounded-2xl bg-brand-50 border border-brand-100 p-6 lg:p-8 text-center">
        <p class="text-lg text-brand-800 font-semibold mb-4">
          Call to schedule your appointment.
        </p>
        <a
          href={`tel:${BUSINESS.phone}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-lg bg-accent-blue text-white font-semibold shadow-lg transition-all duration-300 hover:bg-brand-700 hover:shadow-xl hover:-translate-y-0.5"
        >
          {BUSINESS.phoneDisplay}
        </a>
      </div>
    </article>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
