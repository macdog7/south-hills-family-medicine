---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Providers from '../components/Providers.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { BUSINESS, OG_IMAGE, SITE_URL } from '../config';
import { providers } from '../data/providers';
import { services } from '../data/services';
import { faqs } from '../data/faqs';

const pageTitle = "Nurse Practitioner & Primary Care Clinic in Helena, MT | South Hills Medicine";
const pageDescription = "Compassionate and thorough primary care for adults 18 and older in Helena, Montana. Expert nurse practitioners offering preventive care, chronic condition management, women's & men's health, and same-day visits.";

// schema.org structured data emitted as a @graph: the clinic (MedicalClinic)
// plus a Person node per provider, cross-linked via worksFor/employee. Built
// from src/config.ts and src/data/providers.ts so the schema stays consistent
// with the visible page, the meta tags, and directory listings.
const CLINIC_ID = `${SITE_URL}/#clinic`;

const clinic = {
  "@type": ["MedicalClinic", "MedicalBusiness", "LocalBusiness"],
  "@id": CLINIC_ID,
  name: BUSINESS.name,
  legalName: BUSINESS.legalName,
  alternateName: BUSINESS.alternateNames,
  description: pageDescription,
  url: `${SITE_URL}/`,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  image: OG_IMAGE,
  logo: `${SITE_URL}/favicon.svg`,
  priceRange: BUSINESS.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.region,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.country,
  },
  areaServed: [
    { "@type": "City", name: "Helena" },
    { "@type": "AdministrativeArea", name: "Lewis and Clark County, MT" },
  ],
  medicalSpecialty: "PrimaryCare",
  audience: { "@type": "PeopleAudience", suggestedMinAge: 18 },
  openingHoursSpecification: BUSINESS.hours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  hasMap: BUSINESS.mapUrl,
  sameAs: BUSINESS.sameAs,
  availableService: services.map((s) => ({
    "@type": "MedicalProcedure",
    name: s.title,
    description: s.description,
    ...(s.detail ? { url: `${SITE_URL}/services/${s.slug}/` } : {}),
  })),
  employee: providers.map((p) => ({ "@id": `${SITE_URL}/#provider-${p.id}` })),
};

const providerNodes = providers.map((p) => ({
  "@type": "Person",
  "@id": `${SITE_URL}/#provider-${p.id}`,
  name: p.name,
  jobTitle: p.jobTitle,
  worksFor: { "@id": CLINIC_ID },
  hasCredential: p.credentials.split(",").map((c) => ({
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "certification",
    name: c.trim(),
  })),
  alumniOf: p.alumniOf.map((name) => ({ "@type": "CollegeOrUniversity", name })),
  knowsAbout: p.knowsAbout,
}));

const faqPage = {
  "@type": "FAQPage",
  "@id": `${SITE_URL}/#faq`,
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [clinic, ...providerNodes, faqPage],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <Hero 
      title="Compassionate and thorough Healthcare for Helena and the greater community"
      ctaText="Call to Schedule"
      ctaHref="tel:+14064422205"
    />
    <Services />
    <Providers />
    <Faq />
  </main>
  <Footer />
  
  <!-- Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
