---
// Full announcement of the clinic move + Monday–Friday schedule. Placed at the
// very top of the homepage (before the hero) so nobody misses the new address.
// The sticky MoveBanner strip links here (#moving). Facts come from config.ts
// (UPCOMING / BUSINESS) and the provider data. Remove from index.astro once
// both changes are live.
//
// Hierarchy: the move is primary (big address + directions); the Mon–Fri
// schedule is a secondary card.
import { BUSINESS, UPCOMING } from '../config';
import { providers } from '../data/providers';

const airica = providers.find((p) => p.id === 'airica');
const { street, city, region, postalCode } = UPCOMING.address;
---

<section id="moving" class="bg-notice-50 border-b-4 border-notice" aria-labelledby="moving-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10 lg:py-14">
    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center">
      <!-- Primary: the move -->
      <div class="lg:col-span-3">
        <p class="font-poppins text-brand-700 font-semibold mb-3">A new home and more days to see you!</p>
        <span class="inline-flex items-center gap-2 rounded-full bg-brand-800 text-white px-3 py-1 text-sm font-bold uppercase tracking-wide mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px"
            class="fill-notice" aria-hidden="true">
            <path
              d="M480-480q33 0 56.5-23.5T560-560q0-33-23.5-56.5T480-640q-33 0-56.5 23.5T400-560q0 33 23.5 56.5T480-480Zm0 400Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Z" />
          </svg>
          New location
        </span>
        <h2 id="moving-heading" class="text-4xl lg:text-5xl font-bold text-brand-800 leading-tight mb-4">
          We're moving <span class="whitespace-nowrap">{UPCOMING.moveDate}!</span>
        </h2>
        <p class="text-lg text-gray-700 mb-2">Starting {UPCOMING.moveDate}, you'll find us at our new clinic:</p>
        <address class="not-italic text-2xl lg:text-3xl font-bold text-brand-800 leading-snug mb-6">
          {street}<br />{city}, {region} {postalCode}
        </address>
        <div class="flex flex-wrap gap-3">
          <a href={UPCOMING.mapUrl} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-800 text-white font-semibold shadow-md transition-all duration-300 hover:bg-brand-700 hover:shadow-lg hover:-translate-y-0.5">
            Get directions to the new clinic →
          </a>
          <a href={`tel:${BUSINESS.phone}`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-brand-800 text-brand-800 font-semibold transition-colors hover:bg-brand-800 hover:text-white">
            Call {BUSINESS.phoneDisplay}
          </a>
        </div>
        <p class="text-gray-700 mt-6">
          We can't wait to welcome you into the space — and we're grateful for the patients who make
          our clinic what it is.
        </p>
      </div>

      <!-- Secondary: Mon–Fri schedule -->
      <article class="lg:col-span-2 rounded-2xl bg-white p-6 lg:p-8 border border-gray-200 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="inline-block rounded-md border border-accent-green text-accent-green px-2.5 py-1 text-sm font-bold uppercase tracking-wide">{UPCOMING.hoursStart}</span>
          <span class="text-sm font-semibold text-accent-green uppercase tracking-wide">New schedule</span>
        </div>
        <h3 class="text-xl font-bold text-brand-700 mb-2">Monday–Friday appointments</h3>
        <p class="text-gray-700 leading-relaxed mb-3">
          Starting in {UPCOMING.hoursStart}, we'll be seeing patients Monday through Friday!
        </p>
        <p class="text-gray-700 leading-relaxed">
          {airica ? <strong>{airica.name}, DNP,</strong> : 'One of our providers'} will transition to a
          Tuesday–Friday schedule, helping us offer appointments five days a week and making it easier
          to find a time that works for you.
        </p>
      </article>
    </div>
  </div>
</section>
