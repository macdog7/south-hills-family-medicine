---
import { Image } from 'astro:assets';
import { providers } from '../data/providers';
---

<section id="providers" class="py-12 lg:py-16">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <h2 class="text-3xl lg:text-4xl font-bold text-brand-700 mb-12 text-center">Our Healthcare Providers</h2>

    <div class="space-y-16">
      {providers.map((provider) => (
        <article class="provider-card" key={provider.id}>
          <div class="grid lg:grid-cols-[300px_1fr] gap-8 lg:gap-12">
            <!-- Provider Image -->
            <div class="flex justify-center lg:justify-start">
              <Image
                src={provider.image}
                alt={`${provider.name}, ${provider.credentials} — nurse practitioner at South Hills Medicine in Helena, MT`}
                class="w-full max-w-xs aspect-3/4 object-cover rounded-lg shadow-md"
                loading="lazy"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 200px, 400px"
                format="webp"
                decoding="async"
              />
            </div>

            <!-- Provider Info -->
            <div class="space-y-4">
              <div>
                <h3 class="text-3xl font-bold text-brand-700 mb-2">{provider.name}</h3>
                <p class="text-accent-blue text-base font-semibold tracking-wide mb-3">{provider.credentials}</p>
                {provider.status ? (
                  <div class="inline-block px-3 py-1.5 mt-2 mb-3 bg-accent-green text-white text-sm font-semibold rounded-full shadow-sm">
                    {provider.status}
                  </div>
                ) : null}
              </div>
              {provider.bio.map((paragraph) => (
                <p class="text-gray-700 text-sm leading-relaxed">{paragraph}</p>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .provider-card {
    scroll-margin-top: 100px;
  }

  .provider-card:focus-within {
    outline: 2px solid var(--color-accent-blue);
    outline-offset: 2px;
    border-radius: 0.5rem;
    padding: 1rem;
    margin: -1rem;
  }

</style>
